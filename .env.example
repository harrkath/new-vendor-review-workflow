# Copy this file to .env and fill in the values for your own backend.
# These are the public (publishable) connection values only.
# Never put a secret key, service-role key or database password in here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
VITE_SUPABASE_PROJECT_ID=your-project-id

# Same values, read server-side by server functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_PROJECT_ID=your-project-id
